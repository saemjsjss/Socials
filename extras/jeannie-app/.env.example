# ─────────────────────────────────────────────────────────────
# Jeannie AI · environment template
# Copy to .env.local for local dev, or paste into Vercel →
# Project → Settings → Environment Variables. Every key is optional:
# Jeannie degrades gracefully (offline mode, mock data, browser voice).
# ─────────────────────────────────────────────────────────────

# System Configuration
NEXT_PUBLIC_APP_NAME="Jeannie AI"
NEXT_PUBLIC_VOICE_NAME="Jeannie"

# Access control. When set, every /api route requires this key
# (header `x-jeannie-key` or `Authorization: Bearer <key>`); the HUD asks for it once.
# Strongly recommended on a public deployment: it protects your API credits and admin data.
# Required for memory: the Supabase notes are personal, so they are never used or editable without it.
JEANNIE_ACCESS_KEY=
# Operator's time zone (IANA name) for the Korean session greeting (좋은 아침입니다 / 좋은 저녁입니다 ...)
JEANNIE_TIMEZONE=Asia/Dhaka

# AI & LLM Engine
# LLM_PROVIDER: auto | deepseek | anthropic | openai | ollama
# (auto = DeepSeek when DEEPSEEK_API_KEY is set, else Claude, else OpenAI, else Ollama)
LLM_PROVIDER=auto
# DeepSeek: Jeannie's brain (API key from https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key
# deepseek-v4-flash (default, fast) · deepseek-v4-pro (stronger). Both use the web-search tool.
# (DeepSeek retired the deepseek-chat / deepseek-reasoner names on 24 July 2026.)
DEEPSEEK_MODEL=deepseek-v4-flash
# Images: Claude or OpenAI below when a key is set, else this DeepSeek vision model (experimental)
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=
# Claude (Anthropic API key from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key
# claude-opus-5 (default) · claude-sonnet-5 (cheaper) · claude-haiku-4-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-5
# Model used for image analysis (defaults to ANTHROPIC_MODEL)
ANTHROPIC_VISION_MODEL=
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Optional: any OpenAI-compatible endpoint (e.g. Groq, OpenRouter, Azure proxy)
OPENAI_BASE_URL=
# OpenAI model, and the one used for image analysis (defaults to DEFAULT_MODEL)
DEFAULT_MODEL=gpt-4o
VISION_MODEL=
# Ollama (local dev or a publicly reachable server), e.g. http://localhost:11434.
# Loopback URLs are ignored on Vercel, where they can never be reached.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# Live Web Search: DeepSeek's native web_search (uses DEEPSEEK_API_KEY, no extra key)
# → Tavily → Google Custom Search → DuckDuckGo. Tavily and Google are optional extra fallbacks.
# DeepSeek search goes through its Anthropic-compatible endpoint; override only if DeepSeek moves it.
DEEPSEEK_ANTHROPIC_BASE_URL=
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
TAVILY_API_KEY=your_tavily_search_api_key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Voice Engine: ElevenLabs is Jeannie's main voice (→ Microsoft Edge neural voices → browser speech as fallbacks)
# Use a voice you own or are licensed to use (ElevenLabs Voice Library or your own recording).
# With only the API key set, the premade voice "Rachel" is used, but free plans can't use library voices over
# the API (HTTP 402): set the ID of a voice you created (ElevenLabs → Voices → ⋯ → Copy voice ID).
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE_EN=en-US-JennyNeural
EDGE_TTS_VOICE_KO=ko-KR-SunHiNeural
# Voice for English replies that contain Korean words (reads both languages)
EDGE_TTS_VOICE_MIXED=en-US-EmmaMultilingualNeural

# Supabase: Jeannie's memory (uploaded markdown / JSON Lines notes) AND the Hangeul data Hangeul BOT
# publishes (students, verifications, consultations, document checks, reports...), in one project
# (dcbcbpwpmdtaanboetiz). Apply supabase/migrations/*.sql to it first (SQL editor, or `supabase db push`).
# The URL can also be given as NEXT_PUBLIC_SUPABASE_URL. The key is SERVER ONLY: use the secret
# (sb_secret_…) or legacy service_role key, as SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY, and never
# with a NEXT_PUBLIC_ prefix. The publishable/anon key can't read either: the tables only admit the server.
# The Hangeul data holds full student records, so Jeannie serves it only with JEANNIE_ACCESS_KEY set and
# presented (or in the Telegram admin chat). Jeannie never talks to the Hangeul portal itself.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional, not used by Jeannie today (the browser never talks to Supabase directly).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Telegram Reporting Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id
# Required: secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token (set it when registering the
# webhook). Without it the webhook refuses all updates. Until TELEGRAM_ADMIN_CHAT_ID is set, the bot
# only answers /start, /help and /whoami.
TELEGRAM_WEBHOOK_SECRET=

# true: the session greeting uses its fixed template instead of the language model.
MOCK_MODE=false

# Optional: a caller presenting `Authorization: Bearer $CRON_SECRET` counts as trusted for memory (for a
# Vercel Cron job you add yourself; vercel.json schedules none). It never unlocks the Hangeul data: that
# needs JEANNIE_ACCESS_KEY set and presented.
CRON_SECRET=
