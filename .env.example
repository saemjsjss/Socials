# =================================================================
# Hangeul Admin API & Agentic Telegram Reporting Bot Configuration
# =================================================================
# Copy this file to .env in the same folder (the BOT folder) and fill it in.
# Every key below is read by src/config.py. A key left out of .env takes the
# default shown in src/config.py; a Windows environment variable with the same
# name overrides the value written here.

# Operation Mode.
# false = read the live admin portal (what a real deployment needs).
# true  = demo mode: the basic lookups (dashboard, applications, inquiries and
#         similar) answer with fake demo data (made-up students and numbers).
#         It is NOT an offline switch: several chat commands and the scheduled
#         jobs (sheet sync, passport watcher, issue-date refresh, missing report)
#         still read the real portal and Google Sheets. For a test that must not
#         reach them, also set ENABLE_SCHEDULED_REPORTS=false.
#         If this line is missing, the bot falls back to true.
MOCK_MODE=false

# Hangeul Admin Portal Credentials (the bot only reads from the portal)
HANGEUL_BASE_URL=https://hangeul.com.bd/admin
HANGEUL_USERNAME=your_portal_username_here
HANGEUL_PASSWORD=your_portal_password_here

# Local LLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Telegram Bot Credentials
# Obtain your bot token from @BotFather on Telegram. The bot treats this exact
# placeholder as "no token" and does not start its Telegram side.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your own Telegram user ID (a number). Always allowed to use the bot, and the
# ONLY recipient of the daily brief (DAILY_REPORT_TIME), the passport-watcher
# alerts and the command list the bot pins when it starts. While this is empty
# those three are skipped, even if TELEGRAM_AUTHORIZED_CHAT_IDS is filled in.
# If this and TELEGRAM_AUTHORIZED_CHAT_IDS are both empty, the bot refuses
# everyone. Its "Unauthorized" reply shows the sender's chat ID: send the bot
# /start, copy the ID from that reply to here, then restart the bot.
TELEGRAM_ADMIN_CHAT_ID=

# Extra Telegram user IDs allowed to use the bot, e.g. colleagues
# (comma or space separated, e.g. 111111111,222222222).
TELEGRAM_AUTHORIZED_CHAT_IDS=

# Who receives the messages of the background sync jobs (comma or space
# separated): the 15-minute portal-sync summaries (including the document-check
# results and repeated-failure warnings) and the 09:05 missing-information
# report with its Excel file of student data. Empty = TELEGRAM_ADMIN_CHAT_ID
# plus everyone in TELEGRAM_AUTHORIZED_CHAT_IDS. Set it to restrict these
# messages to specific people (list yourself too if you want them). It does not
# change who gets the daily brief or the passport alerts (see above).
TELEGRAM_BRIEF_CHAT_IDS=

# Automated Report Schedule
# DAILY_REPORT_TIME is 24-hour HH:MM in REPORT_TIMEZONE (18:05 = 6:05 PM).
DAILY_REPORT_TIME=18:05
REPORT_TIMEZONE=Asia/Dhaka
# false switches off EVERY scheduled job, not just the brief: the 15-minute
# portal sync, the passport watcher, the 08:30 issue-date refresh and the
# 09:05 missing-information report.
ENABLE_SCHEDULED_REPORTS=true

# Gmail, for the /sendmail command. It stays off until both are set.
# GMAIL_APP_PASSWORD must be a Google APP PASSWORD (16 characters), NOT the
# account password: Google Account -> Security -> 2-Step Verification ->
# App passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Server Settings (REST API)
# 0.0.0.0 listens on every network interface; 127.0.0.1 would be this PC only.
API_HOST=0.0.0.0
API_PORT=8000

# Local folders (optional)
# Leave these commented out to use the defaults, which sit beside the BOT folder:
#   DOCS_ROOT            <parent of BOT>\VERIFIED STUDENT DOCUMENTS
#   DOCS_ORIGINALS_ROOT  <parent of BOT>\VERIFIED STUDENT DOCUMENTS - ORIGINALS OVER 2MB
#   KONYANG_ROOT         <parent of BOT>\KONYANG DOCUMENTS (skipped if it does not exist)
#   VERIFICATION_DIR     <BOT>\data\verification
# With the bot in E:\BOT these are E:\VERIFIED STUDENT DOCUMENTS and so on, exactly
# as before. The lines below show the defaults for a bot in C:\Hangeul\BOT.
# Write paths WITHOUT quotes (spaces are fine): inside "double quotes" a sequence
# such as \n or \t turns into a control character. A relative path counts from
# the BOT folder.
#DOCS_ROOT=C:\Hangeul\VERIFIED STUDENT DOCUMENTS
#DOCS_ORIGINALS_ROOT=C:\Hangeul\VERIFIED STUDENT DOCUMENTS - ORIGINALS OVER 2MB
#KONYANG_ROOT=C:\Hangeul\KONYANG DOCUMENTS
#VERIFICATION_DIR=C:\Hangeul\BOT\data\verification

# Not read from this file
# The Telegram DNS workaround (src/net_fix.py) reads TELEGRAM_DNS_FIX and
# TELEGRAM_API_IP from the Windows environment only; a value written in .env is
# ignored. To use them, set a user environment variable instead, e.g.
#   setx TELEGRAM_DNS_FIX false
# which reaches only programs started afterwards (sign out and back in).
# Likewise SSL_CERT_FILE, REQUESTS_CA_BUNDLE and the other CA-bundle variables are
# set automatically from data\windows-ca.pem (src/__init__.py) unless already set
# in the Windows environment; putting them in .env has no effect.
