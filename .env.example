# =================================================================
# Hangeul Admin API & Agentic Telegram Reporting Bot Configuration
# =================================================================

# Operation Mode: Set to true to test with realistic mock data immediately.
# Set to false to connect directly to the live admin portal.
MOCK_MODE=true

# Hangeul Admin Portal Credentials
HANGEUL_BASE_URL=https://hangeul.com.bd/admin
HANGEUL_USERNAME=admin
HANGEUL_PASSWORD=your_secure_password_here

# Local LLM (Ollama) Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Telegram Bot Credentials
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID or group chat ID (get it from @userinfobot)
# If left empty, the first user to send /start will be authorized.
TELEGRAM_ADMIN_CHAT_ID=

# Automated Report Schedule (24-hour format, e.g. 09:00 for 9 AM daily digest)
DAILY_REPORT_TIME=09:00
ENABLE_SCHEDULED_REPORTS=true

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
